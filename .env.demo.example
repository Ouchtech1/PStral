# Copy to .env.demo and set a random value of at least 32 characters.
SECRET_KEY=replace-with-a-random-32-character-secret

# Use a preloaded local GGUF model. The default is Qwen3.5-2B Q4_K_M.
OLLAMA_MODEL=hf.co/unsloth/Qwen3.5-2B-GGUF:Q4_K_M
OLLAMA_NUM_THREADS=2
OLLAMA_KEEP_ALIVE=30m
DEMO_PROFILE=synthetic
